  "narrative": {
    "northStar": "Reso UI V2.1 — a quiet conversation",
    "overview": "Reso UI V2.1 uses a quiet, light mobile conversation space. Pale blue and pink action gradients sit beside neutral chat bubbles and lavender story cards. The supplied Reso character and story illustrations carry the personality; the interface supports them with restrained chrome and rounded surfaces.\n\nThis documents the existing implementation, rather than proposing a new identity. `src/styles.css` owns the implemented values; `src/App.tsx` owns the Button, Bubble, Card, and native Dialog conventions.",
    "keyCharacteristics": [
      "Single-column mobile conversations and inline cards.",
      "Pale blue/pink gradient actions, neutral and lavender surfaces.",
      "Original Reso mascot and supplied story imagery.",
      "Clear dark text, visible focus, and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Source Continuity Rule",
        "body": "Keep the original gradient, mascot, and story imagery together; they define the supplied visual world.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do reuse the supplied Reso mascot and story images.",
      "Do keep primary actions in the existing pale blue/pink gradient.",
      "Do place exercises, sharing choices, and confirmations inside the conversation.",
      "Do preserve visible keyboard focus, labeled icon buttons, and reduced-motion behavior."
    ],
    "donts": [
      "Don't introduce a new visual identity or replace the supplied imagery.",
      "Don't stretch the mobile composition into a desktop dashboard.",
      "Don't make small supporting text pale enough to lose contrast."
    ]
  }
