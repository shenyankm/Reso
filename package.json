{
  "name": "reso-mobile-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api,worker \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:worker\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test src/demo.test.ts server/core.test.ts server/agent.test.ts server/agent-policy.test.ts server/agent-alignment.test.ts server/agent-cases.test.ts server/agent-state.test.ts server/agent-actions.test.ts server/policy-integrity.test.ts shared/navigation.test.ts src/WorkflowCards.test.tsx src/AgentSuggestion.test.tsx src/api.test.ts src/requests.test.ts src/export.test.ts src/drafts.test.ts server/transport.test.ts",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "db:up": "docker compose up -d --wait",
    "dev:web": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:api": "node scripts/run-service.mjs api",
    "dev:worker": "node scripts/run-service.mjs worker",
    "test:integration": "node --env-file=.env --import tsx --test server/integration.test.ts server/accounts.integration.test.ts server/asr.integration.test.ts server/migrations.integration.test.ts server/permissions.integration.test.ts server/prd.integration.test.ts server/stability.integration.test.ts server/performance.integration.test.ts server/agent.integration.test.ts",
    "counselor": "node --env-file=.env --import tsx scripts/counselor.ts",
    "benchmark:performance": "node --env-file=.env --import tsx scripts/benchmark-performance.ts",
    "benchmark:bundle": "node --import tsx scripts/benchmark-bundle.ts",
    "tauri": "tauri",
    "android:init": "node scripts/android.mjs init",
    "android:build": "node scripts/android.mjs build",
    "android:install": "node scripts/android.mjs install",
    "android:build:server": "node scripts/android.mjs build-server",
    "android:install:server": "node scripts/android.mjs install-server",
    "test:e2e": "npm run build && node --env-file=.env --import tsx --test --test-concurrency=1 e2e/android.test.ts e2e/export.test.ts e2e/agent.test.ts e2e/profile.test.ts",
    "test:e2e:live": "node --env-file=.env --import tsx --test e2e/live.test.ts",
    "eval:agent": "node --env-file=.env --import tsx scripts/evaluate-agent.ts",
    "benchmark:agent": "node --env-file=.env --import tsx scripts/benchmark-agent.ts",
    "eval:wang": "node --env-file=.env --import tsx scripts/evaluate-wang.ts",
    "test:m1:isolated": "node --import tsx scripts/verify-m1.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@langchain/langgraph": "^1.7.3",
    "better-auth": "^1.7.22",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "lucide-react": "^1.72.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
